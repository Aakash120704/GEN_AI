import numpy as np
import pandas as pd

distance = np.array([[50], [100], [150], [200], [250], [300]])
fuel = np.array([4.5, 7.8, 12.6, 15.3, 20.8, 23.5])

print("Fuel Consumption Data")

data = pd.DataFrame({
    "Distance (km)": distance.flatten(),
    "Fuel (Litres)": fuel
})

print(data)

from sklearn.linear_model import LinearRegression

model = LinearRegression()
model.fit(distance, fuel)

new_distance = np.array([[180]])
prediction = model.predict(new_distance)

print("Predicted Fuel Consumption:", round(prediction[0], 2), "Litres")

import matplotlib.pyplot as plt

plt.scatter(distance, fuel, label="Actual Data")
plt.plot(distance, model.predict(distance), label="Regression Line")
plt.xlabel("Distance (km)")
plt.ylabel("Fuel (Litres)")
plt.title("Fuel Consumption Prediction")
plt.legend()
plt.show()
